{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/healthz", "destination": "/api/health" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/poll",
      "schedule": "0 14 * * *"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,.github/**,**/__pycache__/**,**/*.md,Dockerfile*,docker-compose*.yml,railway.toml,nixpacks.toml,Procfile,templates/**}"
    }
  }
}
